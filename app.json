{
  "expo": {
    "name": "TimeKeeper",
    "slug": "TimeKeeper",
    "version": "2.1.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "timekeeper",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#111111",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.newArch.timekeeper",
      "versionCode": 8
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "armeabi-v7a",
              "arm64-v8a",
              "x86",
              "x86_64"
            ],
            "extraProguardRules": "# react-native-date-picker: Time4A creates its resource loader by reflection. R8 full mode strips the\n# no-arg constructor that Time4A's own `-keep class` rule leaves out, and the date picker module then fails to load.\n-keep class net.time4j.android.spi.AndroidResourceLoader { <init>(); }"
          }
        }
      ],
      "./plugins/with-android-build-fixes",
      "./plugins/with-widget-configure",
      [
        "expo-widgets",
        {
          "enableAndroid": true,
          "widgets": [
            {
              "name": "CounterWidget",
              "displayName": "TimeKeeper",
              "description": "Days left or days since for one of your counters",
              "ios": null,
              "android": {
                "minWidth": 110,
                "minHeight": 110,
                "targetCellWidth": 2,
                "targetCellHeight": 2,
                "resizeMode": "none",
                "initialLayout": "widgets/CounterWidget.tsx"
              }
            },
            {
              "name": "CounterListWidget",
              "displayName": "TimeKeeper list",
              "description": "All your active counters at a glance",
              "ios": null,
              "android": {
                "minWidth": 250,
                "minHeight": 180,
                "targetCellWidth": 4,
                "targetCellHeight": 3,
                "initialLayout": "widgets/CounterListWidget.tsx"
              }
            }
          ]
        }
      ],
      "expo-background-task",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
